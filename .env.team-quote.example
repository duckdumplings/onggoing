# 팀 견적 전용 설정. .env.local로 복사한 뒤 승인된 값을 입력합니다.
# 실제 키는 이 예제 파일에 저장하거나 Git에 올리지 않습니다.
TMAP_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
# 기존 anon 키 또는 sb_publishable_ 형식의 공개 접근 키만 사용합니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEY / LLM 키는 필요 없습니다.
# 운임표 읽기는 기존 DB SELECT 권한을 따릅니다. 관리자 키로 우회하지 않습니다.
